# Configuração do backup do banco — copie este arquivo para ".backup.env"
# (sem o .example) e preencha. O arquivo .backup.env é ignorado pelo Git.
#
# Os dados vêm em campos separados, então a senha pode ter caracteres
# especiais (@ # $ etc.) SEM precisar de codificação.
# Pegue os valores em: Supabase Dashboard -> Connect -> Session pooler.

DB_HOST="aws-1-sa-east-1.pooler.supabase.com"
DB_PORT="5432"
DB_USER="postgres.ispqekzrrufhzdqhjnck"
DB_PASSWORD="COLE_AQUI_SUA_SENHA"
DB_NAME="postgres"

# (opcional) Pasta onde guardar os backups. Padrão: ../backups
# BACKUP_DIR="/Users/josepereira/Backups/supabase"

# (opcional) Quantos dias manter os backups antes de apagar. Padrão: 14
# RETENTION_DAYS=14
